/* Fox Den quick-controls popup — Fox Den Midnight */
@import "foxden-midnight.rasi"

* {
    font: "Monaspace Radon NF 13";
}

window {
    location: center;
    anchor: center;
    x-offset: 0px;
    y-offset: 0px;
    width: 390px;

    background-color: @midnight;
    border: 2px;
    border-color: @den-border;
    border-radius: 14px;
}

mainbox {
    background-color: transparent;
    spacing: 10px;
    padding: 12px;
}

inputbar {
    background-color: @raised;
    border: 1px;
    border-color: @mint;
    border-radius: 9px;
    padding: 9px 11px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @coral;
    font: "Monaspace Radon NF Bold 13";
}

entry {
    background-color: transparent;
    text-color: @cream;
    placeholder: "Filter controls";
    placeholder-color: @muted;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 7;
    fixed-height: false;
    spacing: 5px;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @cream;
    border: 1px;
    border-color: transparent;
    border-radius: 8px;
    padding: 9px 11px;
}

element selected.normal {
    background-color: @coral;
    border-color: @mint;
    text-color: @midnight;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
