/* Fox Den Launcher — Fox Den Midnight */
@import "foxden-midnight.rasi"

window {
	location: center;
	anchor: center;

	x-offset: 0px;
	y-offset: 0px;
	width: 360px;

	background-color: @midnight;

	border: 2px;
	border-color: @den-border;
	border-radius: 12px;
}

mainbox {
	background-color: @midnight;

	padding: 10px;
	spacing: 8px;

	childer: [ inputbar, listview ];
}

inputbar {
	background-color: @raised;

	padding: 7px 9px;
	spacing: 8px;

	border: 0px 0px 1px 0px;
	border-color: @den-border;
	border-radius: 8px;
}

prompt {
	background-color: transparent;
	text-color: @amber;
	font: "Monaspace Radon NF Bold 13";
}

entry {
	background-color: transparent;
	text-color: @cream;

	placeholder: "Search the den...";
	placeholder-color: @muted;
}

listview {
	background-color: @midnight;

	lines: 6;
	spacing: 4px;

	scrollbar: false;
	dynamic: true;
}

element {
	background-color: transparent;
	text-color: @cream;

	padding: 8px 10px;

	border: 1px;
	border-color: transparent;
	border-radius: 8px;
}

element selected {
	background-color: @coral;
	text-color: @midnight;

	border: 1px;
	border-color: @mint;
}

element-text {
	background-color: transparent;
	text-color: inherit;
}

element-text selected {
	text-color: @midnight;
}

element-icon {
	background-color: transparent;
}
